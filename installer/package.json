{
  "name": "lexis-installer",
  "version": "1.1.0",
  "description": "Кастомный установщик Lexis Tools",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lexistools.installer",
    "productName": "Lexis Tools Installer",
    "directories": { "output": "../release-installer" },
    "asar": false,
    "files": ["main.js", "preload.js", "renderer/**/*", "config.json", "app/**/*"],
    "win": {
      "icon": "../build/icon.ico",
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "Lexis-Tools-Setup-${version}.exe"
    }
  }
}